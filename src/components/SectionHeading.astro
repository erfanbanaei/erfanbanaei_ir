---
import { ArrowRight } from 'lucide-react';

interface Props {
  title: string;
  id?: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  as?: 'h1' | 'h2';
}

const { title, id, description, href, linkLabel, as: Tag = 'h2' } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-3" data-reveal>
  <div class="max-w-2xl space-y-2">
    <Tag id={id} class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</Tag>
    {description && <p class="text-muted-foreground">{description}</p>}
  </div>
  {
    href && linkLabel && (
      <a href={href} class="group inline-flex items-center gap-1.5 text-sm font-medium text-brand">
        {linkLabel}
        <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5" aria-hidden />
      </a>
    )
  }
</div>
