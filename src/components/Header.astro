---
import { Languages, Menu, X } from 'lucide-react';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { localize, useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
  path: string;
  name: string;
}

const { lang, path, name } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'fa' ? 'en' : 'fa';

const primary = [
  { href: '/about/', label: t('nav.about') },
  { href: '/projects/', label: t('nav.projects') },
  { href: '/blog/', label: t('nav.blog') },
  { href: '/resume/', label: t('nav.resume') },
  { href: '/contact/', label: t('nav.contact') },
];
const secondary = [
  { href: '/now/', label: t('nav.now') },
  { href: '/uses/', label: t('nav.uses') },
];
const isActive = (href: string) => path === href || path.startsWith(href);
const initials = 'EB';
---

<header class="no-print sticky top-0 z-40 border-b border-transparent bg-background/80 backdrop-blur-md transition-colors data-[scrolled]:border-border" data-header>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={localize(lang, '/')} class="group flex items-center gap-2.5 rounded-md font-semibold">
      <span
        class="grid size-9 place-items-center rounded-lg bg-primary/12 text-sm font-bold text-brand ring-1 ring-primary/30 transition-transform group-hover:scale-105"
        aria-hidden="true">{initials}</span
      >
      <span class="sr-only sm:not-sr-only">{name}</span>
    </a>

    <nav aria-label={t('nav.main')} class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          primary.map((item) => (
            <li>
              <a
                href={localize(lang, item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={localize(other, path)}
        hreflang={other}
        lang={other}
        aria-label={t('lang.switchLabel')}
        class="inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
        data-lang-switch
      >
        <Languages className="size-4" aria-hidden />
        <span>{t('lang.switch')}</span>
      </a>
      <ThemeToggle
        labels={{ toggle: t('theme.toggle'), light: t('theme.light'), dark: t('theme.dark'), system: t('theme.system') }}
      />
      <button
        type="button"
        class="inline-flex size-9 items-center justify-center rounded-md hover:bg-accent md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t('nav.menu')}
        data-menu-button
        data-label-open={t('nav.menu')}
        data-label-close={t('nav.close')}
      >
        <Menu className="size-5 [[aria-expanded=true]>&]:hidden" aria-hidden />
        <X className="hidden size-5 [[aria-expanded=true]>&]:block" aria-hidden />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label={t('nav.main')} class="hidden border-t bg-background md:hidden" data-menu>
    <ul class="container-page grid gap-1 py-3">
      {
        [...primary, ...secondary].map((item) => (
          <li>
            <a
              href={localize(lang, item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="block rounded-md px-3 py-2.5 text-muted-foreground hover:bg-accent hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:text-foreground"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!button || !menu) return;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '');
    menu.classList.toggle('hidden', !open);
  };
  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });

  // Keep the #hash when switching language (e.g. /about/#experience).
  document.querySelector<HTMLAnchorElement>('[data-lang-switch]')?.addEventListener('click', (e) => {
    const link = e.currentTarget as HTMLAnchorElement;
    if (location.hash) link.href = link.href.split('#')[0] + location.hash;
  });
</script>
