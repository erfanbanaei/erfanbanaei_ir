---
import { ArrowUpRight } from 'lucide-react';
import ProjectCover from '@/components/ProjectCover.astro';
import TechBadges from '@/components/TechBadges.astro';
import SocialIcon from '@/components/SocialIcon.astro';
import type { Project } from '@/lib/content';
import { localize, useTranslations, type Lang } from '@/i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { project, lang, headingLevel: H = 'h3', eager = false } = Astro.props;
const t = useTranslations(lang);
const { data } = project;
const href = localize(lang, `/projects/${project.id}/`);
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-xl border bg-card shadow-xs transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5"
  data-project
  data-type={data.type}
  data-tech={JSON.stringify(data.tech)}
>
  <ProjectCover id={project.id} title={data.title.en} cover={data.cover} alt={data.title[lang]} eager={eager} />
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-center gap-2 text-xs text-muted-foreground">
      <span>{t(`type.${data.type}`)}</span>
      {data.featured && <span class="rounded-full bg-primary/10 px-2 py-0.5 text-brand">{t('projects.featured')}</span>}
    </div>
    <H class="text-lg font-semibold">
      <a href={href} class="after:absolute after:inset-0 after:content-['']">
        {data.title[lang]}
      </a>
    </H>
    <p class="line-clamp-2 text-sm text-muted-foreground">{data.summary[lang]}</p>
    <div class="mt-auto flex items-end justify-between gap-3 pt-2">
      <TechBadges items={data.tech} limit={4} />
      <div class="relative z-10 flex shrink-0 gap-1">
        {
          data.links.github && (
            <a
              href={data.links.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t('projects.github')}: ${data.title[lang]}`}
              class="grid size-8 place-items-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground"
            >
              <SocialIcon id="github" class="size-4" />
            </a>
          )
        }
        {
          data.links.demo && (
            <a
              href={data.links.demo}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${t('projects.demo')}: ${data.title[lang]}`}
              class="grid size-8 place-items-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground"
            >
              <ArrowUpRight className="size-4 rtl:-scale-x-100" aria-hidden />
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>
