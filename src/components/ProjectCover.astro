---
import { asset } from '@/i18n/utils';

interface Props {
  id: string;
  title: string;
  cover?: string;
  alt: string;
  eager?: boolean;
  class?: string;
}

const { id, title, cover, alt, eager = false, class: className = '' } = Astro.props;

// Deterministic hue near the brand cyan/blue range for projects without a cover.
const hash = [...id].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const hue = 175 + (hash % 50);
const initial = title.trim().charAt(0).toUpperCase();
---

<div class:list={['relative aspect-[16/10] overflow-hidden bg-muted', className]}>
  {
    cover ? (
      <img
        src={asset(cover)}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
        width="1600"
        height="1000"
        class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    ) : (
      <div
        class="grid size-full place-items-center"
        style={`background: radial-gradient(circle at 30% 20%, hsl(${hue} 90% 55% / .35), transparent 60%), radial-gradient(circle at 80% 90%, hsl(${hue + 30} 90% 55% / .25), transparent 55%), var(--muted);`}
        role="img"
        aria-label={alt}
      >
        <div class="flex aspect-[9/16] h-3/4 flex-col items-center justify-center rounded-2xl border border-foreground/10 bg-card/70 shadow-lg backdrop-blur transition-transform duration-500 group-hover:-translate-y-1">
          <span class="text-3xl font-bold text-brand" aria-hidden="true">{initial}</span>
          <span class="mt-2 h-1 w-8 rounded-full bg-foreground/10" aria-hidden="true" />
          <span class="mt-1.5 h-1 w-5 rounded-full bg-foreground/10" aria-hidden="true" />
        </div>
      </div>
    )
  }
</div>
