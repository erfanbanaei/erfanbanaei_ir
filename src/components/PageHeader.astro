---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<section class="hero-glow relative overflow-hidden">
  <div class="grid-pattern pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="container-page relative pt-16 pb-12 sm:pt-20">
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h1>
    {description && <p class="mt-4 max-w-2xl text-lg text-pretty text-muted-foreground">{description}</p>}
    <slot />
  </div>
</section>
