---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getNow } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/seo';
import { formatDate, langFromParam, localeStaticPaths, localize, useTranslations } from '@/i18n/utils';

export const getStaticPaths = localeStaticPaths;

const lang = langFromParam(Astro.params.locale);
const t = useTranslations(lang);
const now = await getNow();
---

<BaseLayout
  lang={lang}
  title={t('now.title')}
  description={t('now.description')}
  modifiedTime={now.updated}
  jsonLd={[breadcrumbSchema([{ name: t('nav.home'), path: localize(lang, '/') }, { name: t('now.title'), path: localize(lang, '/now/') }], Astro.site)]}
>
  <PageHeader title={t('now.title')} description={t('now.description')}>
    <p class="mt-6 text-sm text-muted-foreground">
      {t('now.updated')} <time datetime={now.updated} class="font-medium text-foreground">{formatDate(lang, now.updated)}</time>
    </p>
  </PageHeader>
  <div class="container-page max-w-3xl py-8">
    <div class="prose-site text-lg" set:html={now.html.body?.[lang]} />
    <p class="mt-12 border-t pt-6 text-sm text-muted-foreground">
      {t('now.about').split('nownow.com')[0]}<a href="https://nownow.com/about" class="link" target="_blank" rel="noopener noreferrer">nownow.com</a>{t('now.about').split('nownow.com')[1]}
    </p>
  </div>
</BaseLayout>
