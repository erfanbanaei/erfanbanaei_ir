---
import { ArrowLeft, ArrowUpRight, Check, Download } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import TechBadges from '@/components/TechBadges.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SocialIcon from '@/components/SocialIcon.astro';
import { buttonVariants } from '@/components/ui/button';
import { getProjects, getSite } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/seo';
import { asset, formatMonth, langFromParam, localize, locales, useTranslations } from '@/i18n/utils';

export async function getStaticPaths() {
  const projects = await getProjects();
  return locales.flatMap((lang) =>
    projects.map((project) => ({ params: { locale: lang === 'fa' ? undefined : lang, slug: project.id }, props: { project } })),
  );
}

const { project } = Astro.props;
const lang = langFromParam(Astro.params.locale);
const t = useTranslations(lang);
const site = await getSite();
const { data } = project;
const url = localize(lang, `/projects/${project.id}/`);
const others = (await getProjects()).filter((p) => p.id !== project.id).slice(0, 3);
---

<BaseLayout
  lang={lang}
  title={data.title[lang]}
  description={data.summary[lang]}
  image={data.cover || undefined}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: data.title[lang],
      description: data.summary[lang],
      applicationCategory: 'MobileApplication',
      operatingSystem: 'Android, iOS, Web',
      url: new URL(url, Astro.site).href,
      ...(data.cover ? { image: new URL(asset(data.cover), Astro.site).href } : {}),
      ...(data.links.github ? { codeRepository: data.links.github } : {}),
      keywords: data.tech.join(', '),
      author: { '@type': 'Person', name: site.name[lang], url: new URL(localize(lang, '/'), Astro.site).href },
    },
    breadcrumbSchema(
      [
        { name: t('nav.home'), path: localize(lang, '/') },
        { name: t('projects.title'), path: localize(lang, '/projects/') },
        { name: data.title[lang], path: url },
      ],
      Astro.site,
    ),
  ]}
>
  <article class="container-page pt-10 pb-8">
    <a href={localize(lang, '/projects/')} class="group mb-8 inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground">
      <ArrowLeft className="size-4 transition-transform group-hover:-translate-x-0.5 rtl:rotate-180 rtl:group-hover:translate-x-0.5" aria-hidden />
      {t('projects.back')}
    </a>

    <header class="max-w-3xl">
      <p class="eyebrow mb-3">
        {t(`type.${data.type}`)}{data.date && <span class="text-muted-foreground"> · {formatMonth(lang, data.date)}</span>}
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-5xl">{data.title[lang]}</h1>
      <p class="mt-4 text-lg text-pretty text-muted-foreground">{data.summary[lang]}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {
          data.links.demo && (
            <a href={data.links.demo} target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: 'lg' })}>
              {t('projects.demo')}
              <ArrowUpRight className="rtl:-scale-x-100" aria-hidden />
            </a>
          )
        }
        {
          data.links.github && (
            <a href={data.links.github} target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: 'lg', variant: 'outline' })}>
              <SocialIcon id="github" class="size-4" />
              {t('projects.github')}
            </a>
          )
        }
        {
          data.links.store && (
            <a href={data.links.store} target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: 'lg', variant: 'outline' })}>
              <Download aria-hidden />
              {t('projects.store')}
            </a>
          )
        }
      </div>
    </header>

    {
      data.cover && (
        <div class="mt-12 overflow-hidden rounded-2xl border shadow-sm">
          <ProjectCover id={project.id} title={data.title.en} cover={data.cover} alt={data.title[lang]} eager />
        </div>
      )
    }

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_18rem]">
      <div class="min-w-0 space-y-10">
        {
          data.html[lang] && (
            <section aria-labelledby="details">
              <h2 id="details" class="mb-4 text-xl font-semibold">
                {t('projects.details')}
              </h2>
              <div class="prose-site" set:html={data.html[lang]} />
            </section>
          )
        }
        {
          data.features[lang].length > 0 && (
            <section aria-labelledby="features">
              <h2 id="features" class="mb-4 text-xl font-semibold">
                {t('projects.features')}
              </h2>
              <ul class="grid gap-3 sm:grid-cols-2">
                {data.features[lang].map((f) => (
                  <li class="flex gap-3 rounded-lg border bg-card p-4 text-sm shadow-xs">
                    <Check className="mt-0.5 size-4 shrink-0 text-brand" aria-hidden />
                    {f}
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          data.gallery.length > 0 && (
            <section aria-labelledby="gallery">
              <h2 id="gallery" class="mb-4 text-xl font-semibold">
                {t('projects.gallery')}
              </h2>
              <ul class="grid gap-4 sm:grid-cols-2">
                {data.gallery.map((img, i) => (
                  <li>
                    <a href={asset(img)} target="_blank" rel="noopener" class="block overflow-hidden rounded-xl border bg-muted">
                      <img
                        src={asset(img)}
                        alt={`${data.title[lang]} (${i + 1})`}
                        loading="lazy"
                        decoding="async"
                        width="1600"
                        height="1000"
                        class="w-full object-cover transition-transform duration-500 hover:scale-[1.02]"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <h2 class="text-sm font-semibold text-muted-foreground">{t('projects.tech')}</h2>
        <TechBadges items={data.tech} variant="brand" />
      </aside>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="container-page border-t pt-12" aria-labelledby="more-projects">
        <div class="mb-6 flex items-center justify-between">
          <h2 id="more-projects" class="text-xl font-semibold">
            {t('projects.more')}
          </h2>
          <a href={localize(lang, '/projects/')} class="link text-sm">
            {t('home.allProjects')}
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((p) => (
            <ProjectCard project={p} lang={lang} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
