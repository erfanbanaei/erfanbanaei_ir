---
import { Rss } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostCard from '@/components/PostCard.astro';
import { getPosts } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/seo';
import { langFromParam, localeStaticPaths, localize, useTranslations } from '@/i18n/utils';

export const getStaticPaths = localeStaticPaths;

const lang = langFromParam(Astro.params.locale);
const t = useTranslations(lang);
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags[lang]))].sort((a, b) => a.localeCompare(b, lang));

const chip =
  'rounded-full border px-3 py-1 text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground aria-pressed:border-primary aria-pressed:bg-primary/10 aria-pressed:text-brand';
---

<BaseLayout
  lang={lang}
  title={t('blog.title')}
  description={t('blog.description')}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: t('blog.title'),
      url: new URL(localize(lang, '/blog/'), Astro.site).href,
      inLanguage: lang,
      blogPost: posts.map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.title[lang],
        datePublished: p.data.date,
        url: new URL(localize(lang, `/blog/${p.id}/`), Astro.site).href,
      })),
    },
    breadcrumbSchema([{ name: t('nav.home'), path: localize(lang, '/') }, { name: t('blog.title'), path: localize(lang, '/blog/') }], Astro.site),
  ]}
>
  <PageHeader title={t('blog.title')} description={t('blog.description')}>
    <a href={localize(lang, '/rss.xml')} class="mt-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground">
      <Rss className="size-4 text-brand" aria-hidden />
      {t('blog.rss')}
    </a>
  </PageHeader>

  <div class="container-page py-8">
    {
      tags.length > 1 && (
        <div class="mb-10 flex flex-wrap gap-2" role="group" aria-label={t('blog.filter')} data-tag-filters>
          <button type="button" class={chip} aria-pressed="true" data-tag="">
            {t('blog.allTags')}
          </button>
          {tags.map((tag) => (
            <button type="button" class={chip} aria-pressed="false" data-tag={tag}>
              #{tag}
            </button>
          ))}
        </div>
      )
    }
    {
      posts.length === 0 ? (
        <p class="py-16 text-center text-muted-foreground">{t('blog.empty')}</p>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li data-item>
              <PostCard post={post} lang={lang} headingLevel="h2" />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-tag-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];

  function apply(tag: string) {
    for (const item of items) {
      const tags: string[] = JSON.parse(item.querySelector<HTMLElement>('[data-post]')?.dataset.tags ?? '[]');
      item.hidden = !!tag && !tags.includes(tag);
    }
    root?.querySelectorAll<HTMLButtonElement>('[data-tag]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
    history.replaceState(null, '', tag ? `?tag=${encodeURIComponent(tag)}` : location.pathname);
  }

  root?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tag]');
    if (btn) apply(btn.dataset.tag ?? '');
  });
  const initial = new URLSearchParams(location.search).get('tag');
  if (initial) apply(initial);
</script>
