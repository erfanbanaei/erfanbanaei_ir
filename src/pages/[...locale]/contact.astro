---
import { Mail } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactForm from '@/components/ContactForm';
import SocialIcon from '@/components/SocialIcon.astro';
import { getSite } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/seo';
import { langFromParam, localeStaticPaths, localize, useTranslations } from '@/i18n/utils';

export const getStaticPaths = localeStaticPaths;

const lang = langFromParam(Astro.params.locale);
const t = useTranslations(lang);
const site = await getSite();
const handle = (url: string) => {
  try {
    const u = new URL(url);
    const path = u.pathname.replace(/\/$/, '').split('/').filter(Boolean).pop() ?? u.hostname;
    return path.startsWith('@') ? path : `@${path}`;
  } catch {
    return url;
  }
};
---

<BaseLayout
  lang={lang}
  title={t('contact.title')}
  description={t('contact.description')}
  jsonLd={[
    { '@context': 'https://schema.org', '@type': 'ContactPage', name: t('contact.title'), url: new URL(localize(lang, '/contact/'), Astro.site).href },
    breadcrumbSchema([{ name: t('nav.home'), path: localize(lang, '/') }, { name: t('contact.title'), path: localize(lang, '/contact/') }], Astro.site),
  ]}
>
  <PageHeader title={t('contact.title')} description={t('contact.description')} />

  <div class="container-page grid gap-10 py-8 lg:grid-cols-[1fr_20rem]">
    <section class="rounded-2xl border bg-card p-6 shadow-xs sm:p-8" aria-labelledby="form-heading">
      <h2 id="form-heading" class="mb-6 text-xl font-semibold">{t('contact.formTitle')}</h2>
      <ContactForm
        client:visible
        accessKey={site.integrations.web3formsKey}
        email={site.email}
        labels={{
          name: t('contact.name'),
          email: t('contact.email'),
          subject: t('contact.subject'),
          message: t('contact.message'),
          send: t('contact.send'),
          sending: t('contact.sending'),
          success: t('contact.success'),
          error: t('contact.error'),
          mailtoNote: t('contact.mailtoNote'),
        }}
      />
    </section>

    <aside class="space-y-8">
      <section aria-labelledby="direct-heading">
        <h2 id="direct-heading" class="mb-4 text-sm font-semibold text-muted-foreground">{t('contact.direct')}</h2>
        <a href={`mailto:${site.email}`} class="group flex items-center gap-3 rounded-xl border bg-card p-4 shadow-xs transition-colors hover:border-primary/40">
          <span class="grid size-10 place-items-center rounded-lg bg-primary/10 text-brand"><Mail className="size-5" aria-hidden /></span>
          <span class="min-w-0">
            <span class="block text-xs text-muted-foreground">{t('contact.emailMe')}</span>
            <span class="block truncate font-medium group-hover:text-brand" dir="ltr">{site.email}</span>
          </span>
        </a>
      </section>
      <section aria-labelledby="social-heading">
        <h2 id="social-heading" class="mb-4 text-sm font-semibold text-muted-foreground">{t('contact.social')}</h2>
        <ul class="space-y-1">
          {
            site.socials.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="me noopener noreferrer"
                  class="group flex items-center gap-3 rounded-lg px-3 py-2 transition-colors hover:bg-accent"
                >
                  <SocialIcon id={s.id} class="size-[1.1rem] text-muted-foreground group-hover:text-foreground" />
                  <span class="flex-1 text-sm">{s.label[lang]}</span>
                  <span class="text-xs text-muted-foreground" dir="ltr">{handle(s.url)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>
