---
import { ArrowUpRight } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getUses } from '@/lib/content';
import { breadcrumbSchema } from '@/lib/seo';
import { usesCategories } from '@/content.config';
import { langFromParam, localeStaticPaths, localize, useTranslations } from '@/i18n/utils';

export const getStaticPaths = localeStaticPaths;

const lang = langFromParam(Astro.params.locale);
const t = useTranslations(lang);
const uses = await getUses();
const groups = usesCategories.map((c) => ({ c, items: uses.filter((u) => u.data.category === c) })).filter((g) => g.items.length);
---

<BaseLayout
  lang={lang}
  title={t('uses.title')}
  description={t('uses.description')}
  jsonLd={[breadcrumbSchema([{ name: t('nav.home'), path: localize(lang, '/') }, { name: t('uses.title'), path: localize(lang, '/uses/') }], Astro.site)]}
>
  <PageHeader title={t('uses.title')} description={t('uses.description')} />
  <div class="container-page max-w-3xl space-y-12 py-8">
    {
      groups.map(({ c, items }) => (
        <section aria-labelledby={`uses-${c}`} data-reveal>
          <h2 id={`uses-${c}`} class="mb-4 text-xl font-semibold">
            {t(`uses.${c}`)}
          </h2>
          <ul class="divide-y rounded-xl border bg-card shadow-xs">
            {items.map(({ data }) => (
              <li class="group relative flex items-start justify-between gap-4 p-5">
                <div>
                  <h3 class="font-medium">
                    {data.url ? (
                      <a href={data.url} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0 group-hover:text-brand">
                        {data.name[lang]}
                      </a>
                    ) : (
                      data.name[lang]
                    )}
                  </h3>
                  {data.description[lang] && <p class="mt-1 text-sm text-muted-foreground">{data.description[lang]}</p>}
                </div>
                {data.url && <ArrowUpRight className="mt-1 size-4 shrink-0 text-muted-foreground group-hover:text-brand rtl:-scale-x-100" aria-hidden />}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
