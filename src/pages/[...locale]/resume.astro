---
import { Download, Mail, Printer } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import { buttonVariants } from '@/components/ui/button';
import { getCertificates, getEducation, getProjects, getSite, getSkills } from '@/lib/content';
import { breadcrumbSchema, personSchema } from '@/lib/seo';
import { asset, formatPercent, formatYear, langFromParam, localeStaticPaths, localize, useTranslations } from '@/i18n/utils';
import { skillCategories } from '@/content.config';

export const getStaticPaths = localeStaticPaths;

const lang = langFromParam(Astro.params.locale);
const t = useTranslations(lang);
const site = await getSite();
const skills = await getSkills();
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
const education = await getEducation();
const certificates = await getCertificates();
const pdf = site.resume[lang];
const siteHost = new URL(Astro.site ?? 'https://erfanbanaei.ir').host;
const h2 = 'mb-4 border-b pb-2 text-sm font-semibold tracking-wide text-brand print:text-black';
---

<BaseLayout
  lang={lang}
  title={t('resume.title')}
  description={`${site.name[lang]}: ${site.role[lang]}. ${t('resume.description')}`}
  jsonLd={[
    personSchema(site, lang, Astro.site),
    breadcrumbSchema([{ name: t('nav.home'), path: localize(lang, '/') }, { name: t('resume.title'), path: localize(lang, '/resume/') }], Astro.site),
  ]}
>
  <div class="container-page max-w-4xl py-10 print:max-w-none print:p-0">
    <div class="no-print mb-8 flex flex-wrap justify-end gap-2">
      {
        pdf && (
          <a href={asset(pdf)} download class={buttonVariants()}>
            <Download aria-hidden />
            {t('resume.download')}
          </a>
        )
      }
      <button type="button" class={buttonVariants({ variant: pdf ? 'outline' : 'default' })} data-print>
        <Printer aria-hidden />
        {t('resume.print')}
      </button>
    </div>

    <article class="rounded-2xl border bg-card p-6 shadow-xs sm:p-10 print:border-0 print:p-0 print:shadow-none">
      <header class="flex flex-col gap-4 border-b pb-8 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">{site.name[lang]}</h1>
          <p class="mt-1 text-lg text-brand print:text-black">{site.role[lang]}</p>
        </div>
        <ul class="space-y-1 text-sm text-muted-foreground sm:text-end" dir="ltr">
          <li><a href={`mailto:${site.email}`} class="inline-flex items-center gap-1.5 hover:text-foreground"><Mail className="size-3.5" aria-hidden />{site.email}</a></li>
          <li><a href={localize(lang, '/')} class="hover:text-foreground">{siteHost}</a></li>
          {site.socials.filter((s) => ['github', 'linkedin'].includes(s.id)).map((s) => (
            <li><a href={s.url} class="hover:text-foreground">{s.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>
          ))}
        </ul>
      </header>

      <section class="mt-8" aria-labelledby="r-summary">
        <h2 id="r-summary" class={h2}>{t('resume.summary')}</h2>
        <p class="text-pretty">{site.about.short[lang]}</p>
      </section>

      <section class="mt-8" aria-labelledby="r-experience">
        <h2 id="r-experience" class={h2}>{t('about.experience')}</h2>
        <ExperienceTimeline lang={lang} compact />
      </section>

      <section class="mt-8 break-inside-avoid" aria-labelledby="r-skills">
        <h2 id="r-skills" class={h2}>{t('resume.skills')}</h2>
        <dl class="grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            skillCategories.map((cat) => {
              const items = skills.filter((s) => s.data.category === cat);
              return (
                items.length > 0 && (
                  <div>
                    <dt class="text-xs font-medium text-muted-foreground">{t(`skill.${cat}`)}</dt>
                    <dd class="text-sm">
                      {items.map((s, i) => (
                        <>
                          {i > 0 && (lang === 'fa' ? '، ' : ', ')}
                          <bdi>{s.data.name[lang]}</bdi> <span class="text-muted-foreground">({formatPercent(lang, s.data.level)})</span>
                        </>
                      ))}
                    </dd>
                  </div>
                )
              );
            })
          }
        </dl>
      </section>

      {
        projects.length > 0 && (
          <section class="mt-8 break-inside-avoid" aria-labelledby="r-projects">
            <h2 id="r-projects" class={h2}>{t('resume.projects')}</h2>
            <ul class="space-y-3">
              {projects.map((p) => (
                <li>
                  <a href={localize(lang, `/projects/${p.id}/`)} class="font-medium hover:text-brand">{p.data.title[lang]}</a>
                  <span class="text-muted-foreground"> · </span>
                  <span class="text-sm">{p.data.summary[lang]}</span>
                  <span class="block text-xs text-muted-foreground" dir="ltr">{p.data.tech.join(' · ')}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        <section class="break-inside-avoid" aria-labelledby="r-education">
          <h2 id="r-education" class={h2}>{t('about.education')}</h2>
          <ul class="space-y-2 text-sm">
            {education.map(({ data }) => (
              <li>
                <span class="font-medium">{data.title[lang]}</span>
                {[data.institution[lang], data.note[lang], formatYear(lang, data.end)].filter(Boolean).length > 0 && (
                  <span class="block text-muted-foreground">{[data.institution[lang], data.note[lang], formatYear(lang, data.end)].filter(Boolean).join(' · ')}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
        <section class="break-inside-avoid" aria-labelledby="r-certs">
          <h2 id="r-certs" class={h2}>{t('about.certificates')}</h2>
          <ul class="space-y-2 text-sm">
            {certificates.map(({ data }) => (
              <li>
                <span class="font-medium">{data.title[lang]}</span>
                {data.description[lang] && <span class="text-muted-foreground"> · {data.description[lang]}</span>}
                {data.credentialId && <span class="block text-xs text-muted-foreground">{t('about.credential')}: <span dir="ltr">{data.credentialId}</span></span>}
              </li>
            ))}
          </ul>
        </section>
      </div>
    </article>
  </div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
